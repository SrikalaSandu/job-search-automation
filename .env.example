# Copy this file to .env and fill in your real keys. Never commit .env.

# Required — get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only needed if you get a "This API key is not scoped to a workspace" error.
# Find it in the Console: Settings > Workspaces > (your workspace) — the ID
# is in the URL and on the workspace settings page.
ANTHROPIC_WORKSPACE_ID=

# Optional but recommended — free tier at https://developer.adzuna.com/
# Without this, only Greenhouse/Lever companies (config.py) get searched.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
